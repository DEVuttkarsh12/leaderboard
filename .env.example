LEADERBOARD_PROVIDER=codeshib
LEADERBOARD_API_KEY=
SHUFFLE_AFFILIATE_URL=
SHUFFLE_ENABLE_UPSTREAM=false
SHUFFLE_MIN_POLL_INTERVAL_MS=35000
SHUFFLE_SNAPSHOT_STALE_MS=45000
# Use "env" to read the start/end window below; otherwise built-in defaults are used.
SHUFFLE_LEADERBOARD_WINDOW_SOURCE=env
SHUFFLE_LEADERBOARD_START_TIME=1786147293
SHUFFLE_LEADERBOARD_END_TIME=1788739292
DATABASE_URL=
DIRECT_URL=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional when the Discord app redirect URL differs from the request origin.
DISCORD_REDIRECT_URI=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Optional override; default is "user:read channel:read events:subscribe".
KICK_OAUTH_SCOPE=
# Optional when the Kick app redirect URL differs from the request origin.
KICK_REDIRECT_URI=
KICK_WEBHOOK_URL=
KICK_WEBHOOK_PUBLIC_KEY=
KICK_WEBHOOK_SKIP_SIGNATURE=false
KICK_WATCH_CHANNEL_SLUG=
KICK_WATCH_VERIFICATION_MODE=oauth
KICK_WATCH_ACTIVITY_WINDOW_SECONDS=900
KICK_WATCH_REQUIRE_LIVE=true

# Local-only provider simulation. Keep disabled in production.
RANKBOARD_DEV_AUTH=false
RANKBOARD_DEV_AUTH_FORCE=false
RANKBOARD_DEV_AUTH_ADMIN=false
