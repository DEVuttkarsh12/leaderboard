generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLAYER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?

  displayName     String?
  discordId       String?   @unique
  discordUsername String?
  kickId          String?   @unique
  kickUsername    String?
  points          Int       @default(0)
  xp              Int       @default(0)
  role            UserRole  @default(PLAYER)
  banned          Boolean   @default(false)
  bannedReason    String?
  timeoutUntil    DateTime?

  accounts          Account[]
  sessions          Session[]
  casinoAccounts    CasinoAccount[]
  storePurchases    StorePurchase[]
  pointTransactions PointTransaction[]
  bets              UserBet[]
  challengeProgress ChallengeProgress[]
  watchSessions     WatchSession[]
  raffleAccounts    RaffleAccount[]
  raffleEntries     RaffleEntry[]
  tournamentEntries TournamentEntry[]
  huntFollows       HuntFollow[]
  huntClipVotes     HuntClipVote[]
  huntClipSaves     HuntClipSave[]
  supportTickets    SupportTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  REJECTED
}

model StoreItem {
  id          String  @id @default(cuid())
  title       String
  description String
  cost        Int
  tag         String  @default("Reward")
  stock       Int     @default(0)
  unlimited   Boolean @default(false)
  imageLabel  String  @default("NEW")
  imageUrl    String? @db.Text
  active      Boolean @default(true)

  purchases StorePurchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StorePurchase {
  id     String         @id @default(cuid())
  userId String
  itemId String
  cost   Int
  status PurchaseStatus @default(PENDING)

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item StoreItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([itemId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model CasinoAccount {
  id                 String    @id @default(cuid())
  userId             String
  provider           String
  username           String
  email              String?
  isVerified         Boolean   @default(false)
  verificationMethod String?
  verificationCode   String?
  verifiedAt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
  @@unique([provider, username])
  @@index([provider, username])
  @@index([provider, email])
}

model PointTransaction {
  id     String @id @default(cuid())
  userId String
  amount Int    // positive = earn, negative = spend
  reason String // e.g. "leaderboard_sync", "store_purchase", "admin_grant"
  meta   String @default("") // JSON string for extra context

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

enum MarketStatus {
  LIVE
  LOCKED
  SETTLED
  CANCELLED
}

enum BetStatus {
  OPEN
  WON
  LOST
  REFUNDED
}

model BetMarket {
  id        String       @id @default(cuid())
  title     String
  type      String       @default("Stream")
  deadline  String       @default("23:59")
  status    MarketStatus @default(LIVE)
  sideA     String       @default("Yes")
  sideB     String       @default("No")
  oddsA     Float        @default(2.0)
  oddsB     Float        @default(1.5)
  winner    String?

  bets      UserBet[]

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  settledAt DateTime?
}

model UserBet {
  id              String    @id @default(cuid())
  userId          String
  marketId        String
  side            String
  amount          Int
  odds            Float
  potentialPayout Int
  payout          Int       @default(0)
  status          BetStatus @default(OPEN)

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  market          BetMarket @relation(fields: [marketId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([marketId])
}

enum ChallengeCadence {
  DAILY
  WEEKLY
  MILESTONE
  SEASONAL
}

model ChallengeMission {
  id          String           @id @default(cuid())
  code        String           @unique
  title       String
  reward      Int
  goal        Int              @default(100)
  meta        String
  cadence     ChallengeCadence @default(DAILY)
  active      Boolean          @default(true)
  sortOrder   Int              @default(0)

  progress ChallengeProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChallengeProgress {
  id        String    @id @default(cuid())
  userId    String
  missionId String
  progress  Int       @default(0)
  claimedAt DateTime?

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission ChallengeMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, missionId])
  @@index([userId])
  @@index([missionId])
}

enum WatchSessionStatus {
  ACTIVE
  PAUSED
  CLAIMED
}

model WatchSession {
  id                 String             @id @default(cuid())
  userId             String
  provider           String             @default("kick")
  streamId           String             @default("default")
  status             WatchSessionStatus @default(ACTIVE)
  totalSeconds       Int                @default(0)
  pointsAwarded      Int                @default(0)
  dailyBonusAwarded  Boolean            @default(false)
  startedAt          DateTime           @default(now())
  lastHeartbeatAt    DateTime           @default(now())
  endedAt            DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, startedAt])
}

model KickChatActivity {
  id          String   @id @default(cuid())
  messageId   String   @unique
  kickUserId  String
  username    String
  channelSlug String
  content     String   @db.Text
  createdAt   DateTime
  receivedAt  DateTime @default(now())

  @@index([kickUserId, receivedAt])
  @@index([username, receivedAt])
  @@index([channelSlug, receivedAt])
}

model KickStreamStatus {
  id          String    @id @default(cuid())
  channelSlug String    @unique
  broadcasterKickId String?
  broadcasterUsername String?
  isLive      Boolean   @default(false)
  title       String?
  startedAt   DateTime?
  endedAt     DateTime?
  lastEventAt DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isLive, lastEventAt])
}

enum RaffleRoundStatus {
  OPEN
  DRAWING
  CLOSED
}

model RaffleRound {
  id               String            @id @default(cuid())
  title            String
  ticketRateWager  Int               @default(10000)
  status           RaffleRoundStatus @default(OPEN)
  winnerEntryId    String?
  drawnAt          DateTime?

  accounts RaffleAccount[]
  entries  RaffleEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model RaffleAccount {
  id      String @id @default(cuid())
  userId  String
  roundId String
  tickets Int    @default(0)
  entries Int    @default(0)

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  round RaffleRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roundId])
  @@index([roundId])
}

model RaffleEntry {
  id          String @id @default(cuid())
  userId      String
  roundId     String
  ticketCount Int

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  round RaffleRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([roundId])
}

enum HuntStatus {
  SCHEDULED
  LIVE
  COMPLETED
}

model BonusHuntSession {
  id              String     @id @default(cuid())
  title           String
  host            String
  status          HuntStatus @default(SCHEDULED)
  startBankroll   Int        @default(0)
  currentBankroll Int        @default(0)
  bonusCount      Int        @default(0)
  openedCount     Int        @default(0)
  totalPayout     Int        @default(0)
  bestMultiplier  Float      @default(0)
  startsAt        DateTime?
  active          Boolean    @default(true)
  sortOrder       Int        @default(0)

  follows HuntFollow[]
  clips   HuntClip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([active, sortOrder])
}

model HuntFollow {
  id     String @id @default(cuid())
  userId String
  huntId String

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  hunt BonusHuntSession @relation(fields: [huntId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, huntId])
  @@index([huntId])
}

model HuntClip {
  id         String @id @default(cuid())
  huntId     String
  title      String
  multiplier Float  @default(0)
  votes      Int    @default(0)

  hunt  BonusHuntSession @relation(fields: [huntId], references: [id], onDelete: Cascade)
  voter HuntClipVote[]
  saves HuntClipSave[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([huntId])
}

model HuntClipVote {
  id     String @id @default(cuid())
  userId String
  clipId String

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clip HuntClip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, clipId])
  @@index([clipId])
}

model HuntClipSave {
  id     String @id @default(cuid())
  userId String
  clipId String

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clip HuntClip @relation(fields: [clipId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, clipId])
  @@index([clipId])
}

enum SupportTicketStatus {
  OPEN
  WAITING
  SOLVED
}

model SupportTicket {
  id       String              @id @default(cuid())
  userId   String?
  category String
  subject  String
  message  String              @db.Text
  status   SupportTicketStatus @default(OPEN)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, updatedAt])
}

enum TournamentStatus {
  OPEN
  LOCKED
  COMPLETED
}

model Tournament {
  id        String           @id @default(cuid())
  code      String           @unique
  title     String
  starts    String
  prize     String
  seats     Int
  taken     Int              @default(0)
  status    TournamentStatus @default(OPEN)
  active    Boolean          @default(true)
  sortOrder Int              @default(0)

  entries TournamentEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
  @@index([status])
}

model TournamentEntry {
  id           String @id @default(cuid())
  userId       String
  tournamentId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, tournamentId])
  @@index([tournamentId])
}
